{
  "manifest_version": 3,
  "name": "Image Pocket",
  "version": "1.2.0",
  "description": "Temukan, pilih, dan unduh gambar dari halaman web.",
  "permissions": [
    "activeTab",
    "declarativeNetRequestWithHostAccess",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Image Pocket",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "image-pocket@example.local",
      "strict_min_version": "128.0"
    }
  }
}
