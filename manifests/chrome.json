{
  "manifest_version": 3,
  "name": "Image Pocket",
  "version": "1.5.2",
  "minimum_chrome_version": "109",
  "description": "Temukan, pilih, dan unduh gambar dari halaman web.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "declarativeNetRequestWithHostAccess",
    "downloads",
    "offscreen",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Image Pocket",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
